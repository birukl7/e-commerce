<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;

class TaxSetting extends Model
{
    use HasFactory;

    protected $fillable = [
        'name', 
        'type', 
        'rate', 
        'description', 
        'is_active',
        'country',
        'state',
        'city',
        'postal_code',
        'priority',
        'compound',
        'shipping_taxable',
        'tax_class_id'
    ];

    protected $casts = [
        'rate' => 'decimal:4',
        'is_active' => 'boolean',
        'priority' => 'integer',
        'compound' => 'boolean',
        'shipping_taxable' => 'boolean',
        'tax_class_id' => 'integer'
    ];
    
    protected $appends = ['formatted_rate', 'display_name'];
    
    /**
     * Get the products associated with this tax setting.
     */
    public function products()
    {
        return $this->hasMany(Product::class);
    }
    
    protected static function booted()
    {
        static::saving(function ($taxSetting) {
            // Ensure priority is set and is a positive integer
            if (empty($taxSetting->priority)) {
                $taxSetting->priority = static::max('priority') + 1;
            }
        });
    }

    /**
     * Scope to get only active tax settings
     */
    public function scopeActive($query)
    {
        return $query->where('is_active', true);
    }
    
    /**
     * Get the tax class that this rate belongs to.
     */
    public function taxClass()
    {
        return $this->belongsTo(TaxClass::class);
    }
    
    /**
     * Scope a query to only include rates for a specific tax class.
     */
    public function scopeForTaxClass($query, $taxClassId)
    {
        return $query->where('tax_class_id', $taxClassId);
    }
    
    /**
     * Scope to get compound taxes
     */
    public function scopeCompound($query)
    {
        return $query->where('compound', true);
    }
    
    /**
     * Scope to get shipping taxable taxes
     */
    public function scopeShippingTaxable($query)
    {
        return $query->where('shipping_taxable', true);
    }

    /**
     * Scope to get taxes for a specific location
     */
    public function scopeForLocation($query, $country, $state = null, $city = null, $postalCode = null)
    {
        return $query->where('country', strtoupper($country))
            ->when($state, function ($q) use ($state) {
                return $q->where('state', $state);
            })
            ->when($city, function ($q) use ($city) {
                return $q->where('city', $city);
            })
            ->when($postalCode, function ($q) use ($postalCode) {
                return $q->where('postal_code', $postalCode);
            });
    }
    
    /**
     * Scope to get non-compound taxes
     */
    public function scopeNonCompound($query)
    {
        return $query->where('compound', false);
    }
    
    /**
     * Scope to filter by country
     */
    public function scopeForCountry($query, $countryCode)
    {
        return $query->where('country', $countryCode);
    }
    
    /**
     * Scope to filter by state
     */
    public function scopeForState($query, $stateCode)
    {
        return $query->where('state', $stateCode);
    }
    
    /**
     * Scope to filter by city
     */
    public function scopeForCity($query, $city)
    {
        return $query->where('city', $city);
    }
    
    /**
     * Scope to filter by postal code
     */
    public function scopeForPostalCode($query, $postalCode)
    {
        return $query->where('postal_code', $postalCode);
    }

    /**
     * Calculate tax amount for a given base amount
     */
    public function calculateTax(float $amount): float
    {
        if ($this->type === 'percentage') {
            return ($amount * $this->rate) / 100;
        }
        
        return $this->rate; // Fixed amount
    }
    
    /**
     * Get the tax class that this rate belongs to.
     */
    public function taxClass()
    {
        return $this->belongsTo(TaxClass::class);
    }
    
    /**
     * Scope a query to only include rates for a specific tax class.
     */
    public function scopeForTaxClass($query, $taxClassId)
    {
        return $query->where('tax_class_id', $taxClassId);
    }
    
    /**
     * Get the display name with rate and location
     */
    public function getDisplayNameAttribute(): string
    {
        $name = $this->name;
        
        if ($this->country) {
            $name .= ' - ' . $this->country;
            if ($this->state) {
                $name .= ', ' . $this->state;
            }
        }
        
        return "{$name} ({$this->formatted_rate})";
    }

    /**
     * Get formatted rate display
     */
    public function getFormattedRateAttribute(): string
    {
        if ($this->type === 'percentage') {
            return $this->rate . '%';
        }
        
        return 'ETB ' . number_format($this->rate, 2);
    }
    
    /**
     * Get all products that use this tax rate
     */
    public function products()
    {
        return $this->belongsToMany(Product::class, 'product_tax')
            ->withTimestamps();
    }
}